# Copy to .env.local for local development — never commit .env.local

# Public site URL used for canonical links, sitemap, and social cards
NEXT_PUBLIC_SITE_URL=https://guy-boitout.com

# Resend (transactional email)
RESEND_API_KEY=

# Resend sender ("Name <address@domain>"); the domain must be verified in Resend
EMAIL_FROM=

# Stripe — the online book is the only product sold on the site
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Not used: checkout is Stripe-hosted, so no Stripe.js runs on the site.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Set to "true" only once Stripe Tax has an origin address and the VAT
# registrations you need; leave false and the €70 price is charged as displayed.
STRIPE_AUTOMATIC_TAX=false
# Price id of the enriched online book (price_… from the Stripe dashboard).
# Use the test-mode id with a test-mode secret key.
STRIPE_PRICE_ONLINE_BOOK=
# Master switch for checkout. Until this is "true" the pricing card keeps its
# "notify me at launch" link and /api/checkout answers 503.
NEXT_PUBLIC_PAYMENTS_ENABLED=false

# Database (Neon Postgres)
DATABASE_URL=

# Auth (magic-link JWT signing)
AUTH_SECRET=

# Admin dashboard password
ADMIN_PASSWORD=

# Azure RAG search
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_ADMIN_KEY=
AZURE_SEARCH_QUERY_KEY=
AZURE_SEARCH_INDEX=rop-book

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.6-terra

# Azure Document Intelligence (slide OCR)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_INTELLIGENCE_API_VERSION=2024-11-30
